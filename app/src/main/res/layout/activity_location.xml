<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LocationActivity">

    <FrameLayout
        android:id="@+id/location_header"
        android:layout_marginTop="36dp"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:elevation="10dp"
        android:layout_width="match_parent"
        android:background="#fff"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:editable="false"
                android:inputType="none"
                android:background="#fff"
                android:drawablePadding="@dimen/activity_horizontal_margin"
                android:id="@+id/myLocation"
                android:drawableStart="@drawable/ic_fiber_"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_horizontal_margin"
                android:hint="Your location"
                android:textColor="@color/textColor"/>
        </RelativeLayout>
    </FrameLayout>

    <fragment
        android:name="com.google.android.gms.maps.MapFragment"
        android:id="@+id/mapView"
        android:layout_below="@id/location_header"
        android:layout_above="@id/btn_confirm_location"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btn_confirm_location"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:onClick="confirmLocation"
        android:text="Use This Location"
        android:textColor="#ffffff"
        android:background="@drawable/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</RelativeLayout>